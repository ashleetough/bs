1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="ANI8/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "ANI8/SCENE",1
1026 ! --- object slots come from the config block above ---
1027 QT1=0
1028 QF1=1
1029 QD1=1
1030 ! --- set up all instances ---
1031 FOR I=1 TO NM
1032 MODSET I,MB(I),MO(I)
1033 MODDISP I
1034 MODPOS I,MX(I),MY(I),MZ(I)
1035 MODOPT I,MS(I),1,0,1
1036 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1037 NEXT I
1038 BGCOL 0,0,0
1039 AMBCOL 180,180,190
1040 LIGVEC 1,0.4,-1,0.3
1041 LIGCOL 1,255,255,220
1042 CX=0.0
1043 CY=0.0
1044 CZ=180
1045 CYW=3.1416
1046 CPT=0.0000
1047 SHUD=1
1048 XVSEL=0
1049 CLEAR
1050 DO
1051  QT1=QT1+1
1052  IF QT1>=8 THEN QF1=QF1+QD1
1053  IF QT1>=8 THEN QT1=0
1054  IF QF1>4 THEN QF1=1
1055  MODSET 1,1,QF1
1056 MFX=SIN(CYW)
1057 MFZ=COS(CYW)
1058 RRX=PAD(1,16)-128
1059 IF ABS(RRX)<25 THEN RRX=0
1060 RRY=PAD(1,15)-128
1061 IF ABS(RRY)<25 THEN RRY=0
1062 CYW=CYW-RRX*0.0003
1063 CPT=CPT+RRY*0.0002
1064 IF CPT>1.5 THEN CPT=1.5
1065 IF CPT<-1.5 THEN CPT=-1.5
1066 LSX=PAD(1,14)-128
1067 IF ABS(LSX)<25 THEN LSX=0
1068 LSZ=PAD(1,13)-128
1069 IF ABS(LSZ)<25 THEN LSZ=0
1070 CX=CX-(LSX*MFZ)*0.008
1071 CZ=CZ+(LSX*MFX)*0.008
1072 FW=LSZ*0.008
1073 CX=CX+MFX*FW
1074 CZ=CZ+MFZ*FW
1075 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1076 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1077 IF PAD(1,3)>30 THEN CY=CY-0.5
1078 IF PAD(1,4)>30 THEN CY=CY+0.5
1079 CAMPOS 1,CX,CY,CZ
1080 CAMROT 1,CPT,CYW,0
1081 CLEAR
1082 IF SHUD=1 THEN
1083 LOCATE 0,0
1084 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1085 PRINT "FRAME ";QF1;"/4"
1086 END IF
1087 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1088 IF PAD(1,19)=0 THEN XVSEL=0
1089 IF PAD(1,19)>0 THEN XVSEL=1
1090 IF PAD(1,20)=1 THEN END
1091 FSYNC 1
1092 LOOP
1093 END