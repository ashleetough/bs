1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="ANI6/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "ANI6/SCENE",1
1026 MODLOAD "ANI6/SCENE2",2
1027 TEXLOAD "ANI6/MODEL"
1028 PALLOAD "ANI6/MODEL"
1029 ! --- object slots come from the config block above ---
1030 QT1=0
1031 QF1=1
1032 QD1=1
1033 ! --- set up all instances ---
1034 FOR I=1 TO NM
1035 MODSET I,MB(I),MO(I)
1036 MODDISP I
1037 MODPOS I,MX(I),MY(I),MZ(I)
1038 MODOPT I,MS(I),1,0,1
1039 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1040 NEXT I
1041 BGCOL 0,0,0
1042 AMBCOL 180,180,190
1043 LIGVEC 1,0.4,-1,0.3
1044 LIGCOL 1,255,255,220
1045 CX=0.0
1046 CY=0.0
1047 CZ=180
1048 CYW=3.1416
1049 CPT=0.0000
1050 SHUD=1
1051 XVSEL=0
1052 CLEAR
1053 DO
1054  QT1=QT1+1
1055  IF QT1>=8 THEN QF1=QF1+QD1
1056  IF QT1>=8 THEN QT1=0
1057  IF QF1>18 THEN QF1=1
1058  IF QF1>=1 AND QF1<=10 THEN MODSET 1,1,QF1-0
1059  IF QF1>=11 AND QF1<=18 THEN MODSET 1,2,QF1-10
1060 MFX=SIN(CYW)
1061 MFZ=COS(CYW)
1062 RRX=PAD(1,16)-128
1063 IF ABS(RRX)<25 THEN RRX=0
1064 RRY=PAD(1,15)-128
1065 IF ABS(RRY)<25 THEN RRY=0
1066 CYW=CYW-RRX*0.0003
1067 CPT=CPT+RRY*0.0002
1068 IF CPT>1.5 THEN CPT=1.5
1069 IF CPT<-1.5 THEN CPT=-1.5
1070 LSX=PAD(1,14)-128
1071 IF ABS(LSX)<25 THEN LSX=0
1072 LSZ=PAD(1,13)-128
1073 IF ABS(LSZ)<25 THEN LSZ=0
1074 CX=CX-(LSX*MFZ)*0.008
1075 CZ=CZ+(LSX*MFX)*0.008
1076 FW=LSZ*0.008
1077 CX=CX+MFX*FW
1078 CZ=CZ+MFZ*FW
1079 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1080 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1081 IF PAD(1,3)>30 THEN CY=CY-0.5
1082 IF PAD(1,4)>30 THEN CY=CY+0.5
1083 CAMPOS 1,CX,CY,CZ
1084 CAMROT 1,CPT,CYW,0
1085 CLEAR
1086 IF SHUD=1 THEN
1087 LOCATE 0,0
1088 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1089 PRINT "FRAME ";QF1;"/18"
1090 END IF
1091 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1092 IF PAD(1,19)=0 THEN XVSEL=0
1093 IF PAD(1,19)>0 THEN XVSEL=1
1094 IF PAD(1,20)=1 THEN END
1095 FSYNC 1
1096 LOOP
1097 END