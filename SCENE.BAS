1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="POLY4/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "POLY4/SCENE",1
1026 MODLOAD "POLY4/SCENE2",2
1027 MODLOAD "POLY4/SCENE3",3
1028 ! --- object slots come from the config block above ---
1029 QT1=0
1030 QF1=1
1031 QD1=1
1032 ! --- set up all instances ---
1033 FOR I=1 TO NM
1034 MODSET I,MB(I),MO(I)
1035 MODDISP I
1036 MODPOS I,MX(I),MY(I),MZ(I)
1037 MODOPT I,MS(I),1,0,1
1038 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1039 NEXT I
1040 BGCOL 192,96,32
1041 AMBCOL 180,180,190
1042 LIGVEC 1,0.4,-1,0.3
1043 LIGCOL 1,255,255,220
1044 TILEPOS 1,0,0,640,224,0
1045 ORDER 2
1046 TRICOL3 2,15,204,88,128,15,204,88,128,242,24,223,128
1047 TRIPOS 2,0,0,640,0,0,112,0
1048 TRIDISP 2
1049 TRICOL3 3,15,204,88,128,242,24,223,128,242,24,223,128
1050 TRIPOS 3,640,0,640,112,0,112,0
1051 TRIDISP 3
1052 TRICOL3 4,242,24,223,128,242,24,223,128,192,96,32,128
1053 TRIPOS 4,0,112,640,112,0,224,0
1054 TRIDISP 4
1055 TRICOL3 5,242,24,223,128,192,96,32,128,192,96,32,128
1056 TRIPOS 5,640,112,640,224,0,224,0
1057 TRIDISP 5
1058 CX=0.0
1059 CY=0.0
1060 CZ=180
1061 CYW=3.1416
1062 CPT=0.0000
1063 SHUD=1
1064 XVSEL=0
1065 CLEAR
1066 DO
1067  QT1=QT1+1
1068  IF QT1>=8 THEN QF1=QF1+QD1
1069  IF QT1>=8 THEN QT1=0
1070  IF QF1>18 THEN QF1=1
1071  IF QF1>=1 AND QF1<=6 THEN MODSET 1,1,QF1-0
1072  IF QF1>=7 AND QF1<=12 THEN MODSET 1,2,QF1-6
1073  IF QF1>=13 AND QF1<=18 THEN MODSET 1,3,QF1-12
1074 MFX=SIN(CYW)
1075 MFZ=COS(CYW)
1076 RRX=PAD(1,16)-128
1077 IF ABS(RRX)<25 THEN RRX=0
1078 RRY=PAD(1,15)-128
1079 IF ABS(RRY)<25 THEN RRY=0
1080 CYW=CYW-RRX*0.0003
1081 CPT=CPT+RRY*0.0002
1082 IF CPT>1.5 THEN CPT=1.5
1083 IF CPT<-1.5 THEN CPT=-1.5
1084 LSX=PAD(1,14)-128
1085 IF ABS(LSX)<25 THEN LSX=0
1086 LSZ=PAD(1,13)-128
1087 IF ABS(LSZ)<25 THEN LSZ=0
1088 CX=CX-(LSX*MFZ)*0.008
1089 CZ=CZ+(LSX*MFX)*0.008
1090 FW=LSZ*0.008
1091 CX=CX+MFX*FW
1092 CZ=CZ+MFZ*FW
1093 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1094 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1095 IF PAD(1,3)>30 THEN CY=CY-0.5
1096 IF PAD(1,4)>30 THEN CY=CY+0.5
1097 CAMPOS 1,CX,CY,CZ
1098 CAMROT 1,CPT,CYW,0
1099 CLEAR
1100 IF SHUD=1 THEN
1101 LOCATE 0,0
1102 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1103 PRINT "FRAME ";QF1;"/18"
1104 END IF
1105 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1106 IF PAD(1,19)=0 THEN XVSEL=0
1107 IF PAD(1,19)>0 THEN XVSEL=1
1108 IF PAD(1,20)=1 THEN END
1109 FSYNC 1
1110 LOOP
1111 END