1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="ANI4/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "ANI4/SCENE",1
1026 TEXLOAD "ANI4/MODEL"
1027 PALLOAD "ANI4/MODEL"
1028 ! --- object slots come from the config block above ---
1029 QT1=0
1030 QF1=1
1031 QD1=1
1032 ! --- set up all instances ---
1033 FOR I=1 TO NM
1034 MODSET I,MB(I),MO(I)
1035 MODDISP I
1036 MODPOS I,MX(I),MY(I),MZ(I)
1037 MODOPT I,MS(I),1,0,1
1038 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1039 NEXT I
1040 TILEPOS 1,0,0,640,224,0
1041 TILEDISP 1
1042 TILECOL 4,255,255,255,80
1043 TILEPOS 4,50,30,54,34,1
1044 TILEOFF 4
1045 TILECOL 5,255,255,255,80
1046 TILEPOS 5,120,15,124,19,1
1047 TILEOFF 5
1048 TILECOL 6,255,255,255,80
1049 TILEPOS 6,200,45,204,49,1
1050 TILEOFF 6
1051 TILECOL 7,255,255,255,80
1052 TILEPOS 7,310,20,314,24,1
1053 TILEOFF 7
1054 TILECOL 8,255,255,255,80
1055 TILEPOS 8,380,10,384,14,1
1056 TILEOFF 8
1057 TILECOL 9,255,255,255,80
1058 TILEPOS 9,450,35,454,39,1
1059 TILEOFF 9
1060 TILECOL 10,255,255,255,80
1061 TILEPOS 10,520,18,524,22,1
1062 TILEOFF 10
1063 TILECOL 11,255,255,255,80
1064 TILEPOS 11,580,40,584,44,1
1065 TILEOFF 11
1066 TILECOL 12,255,255,255,80
1067 TILEPOS 12,90,55,94,59,1
1068 TILEOFF 12
1069 TILECOL 13,255,255,255,80
1070 TILEPOS 13,260,8,264,12,1
1071 TILEOFF 13
1072 CX=5.0
1073 CY=-6.0
1074 CZ=16
1075 CYW=0.2945
1076 CPT=0.3490
1077 SHUD=1
1078 XVSEL=0
1079 CLEAR
1080 DO
1081  QT1=QT1+1
1082  IF QT1>=8 THEN QT1=0
1083  IF QT1>=8 THEN QF1=QF1+QD1
1084  IF QF1>18 THEN QF1=1
1085  IF QF1>=1 AND QF1<=10 THEN MODSET 1,1,QF1-0
1086  IF QF1>=11 AND QF1<=18 THEN MODSET 1,2,QF1-10
1087 MFX=SIN(CYW)
1088 MFZ=COS(CYW)
1089 RRX=PAD(1,16)-128
1090 IF ABS(RRX)<25 THEN RRX=0
1091 RRY=PAD(1,15)-128
1092 IF ABS(RRY)<25 THEN RRY=0
1093 CYW=CYW-RRX*0.0003
1094 CPT=CPT+RRY*0.0002
1095 IF CPT>1.5 THEN CPT=1.5
1096 IF CPT<-1.5 THEN CPT=-1.5
1097 LSX=PAD(1,14)-128
1098 IF ABS(LSX)<25 THEN LSX=0
1099 LSZ=PAD(1,13)-128
1100 IF ABS(LSZ)<25 THEN LSZ=0
1101 CX=CX-(LSX*MFZ)*0.008
1102 CZ=CZ+(LSX*MFX)*0.008
1103 FW=LSZ*0.008
1104 CX=CX+MFX*FW
1105 CZ=CZ+MFZ*FW
1106 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1107 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1108 IF PAD(1,3)>30 THEN CY=CY-0.5
1109 IF PAD(1,4)>30 THEN CY=CY+0.5
1110 CAMPOS 1,CX,CY,CZ
1111 CAMROT 1,CPT,CYW,0
1112 CLEAR
1113 IF SHUD=1 THEN
1114 LOCATE 0,0
1115 PRINT "X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1116 END IF
1117 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1118 IF PAD(1,19)=0 THEN XVSEL=0
1119 IF PAD(1,19)>0 THEN XVSEL=1
1120 IF PAD(1,20)=1 THEN END
1121 FSYNC 1
1122 LOOP
1123 END