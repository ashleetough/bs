1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="ANI5/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "ANI5/SCENE",1
1026 TEXLOAD "ANI5/MODEL"
1027 PALLOAD "ANI5/MODEL"
1028 ! --- object slots come from the config block above ---
1029 QT1=0
1030 QF1=1
1031 QD1=1
1032 ! --- set up all instances ---
1033 FOR I=1 TO NM
1034 MODSET I,MB(I),MO(I)
1035 MODDISP I
1036 MODPOS I,MX(I),MY(I),MZ(I)
1037 MODOPT I,MS(I),1,0,1
1038 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1039 NEXT I
1040 BGCOL 0,0,0
1041 AMBCOL 180,180,190
1042 LIGVEC 1,0.4,-1,0.3
1043 LIGCOL 1,255,255,220
1044 TILEPOS 1,0,0,640,224,0
1045 TILEDISP 1
1046 TILECOL 4,255,255,255,80
1047 TILEPOS 4,50,30,54,34,1
1048 TILEOFF 4
1049 TILECOL 5,255,255,255,80
1050 TILEPOS 5,120,15,124,19,1
1051 TILEOFF 5
1052 TILECOL 6,255,255,255,80
1053 TILEPOS 6,200,45,204,49,1
1054 TILEOFF 6
1055 TILECOL 7,255,255,255,80
1056 TILEPOS 7,310,20,314,24,1
1057 TILEOFF 7
1058 TILECOL 8,255,255,255,80
1059 TILEPOS 8,380,10,384,14,1
1060 TILEOFF 8
1061 TILECOL 9,255,255,255,80
1062 TILEPOS 9,450,35,454,39,1
1063 TILEOFF 9
1064 TILECOL 10,255,255,255,80
1065 TILEPOS 10,520,18,524,22,1
1066 TILEOFF 10
1067 TILECOL 11,255,255,255,80
1068 TILEPOS 11,580,40,584,44,1
1069 TILEOFF 11
1070 TILECOL 12,255,255,255,80
1071 TILEPOS 12,90,55,94,59,1
1072 TILEOFF 12
1073 TILECOL 13,255,255,255,80
1074 TILEPOS 13,260,8,264,12,1
1075 TILEOFF 13
1076 CX=0.0
1077 CY=0.0
1078 CZ=180
1079 CYW=3.1416
1080 CPT=0.0000
1081 SHUD=1
1082 XVSEL=0
1083 CLEAR
1084 DO
1085  QT1=QT1+1
1086  IF QT1>=8 THEN QF1=QF1+QD1
1087  IF QT1>=8 THEN QT1=0
1088  IF QF1>18 THEN QF1=1
1089  IF QF1>=1 AND QF1<=10 THEN MODSET 1,1,QF1-0
1090  IF QF1>=11 AND QF1<=18 THEN MODSET 1,2,QF1-10
1091 MFX=SIN(CYW)
1092 MFZ=COS(CYW)
1093 RRX=PAD(1,16)-128
1094 IF ABS(RRX)<25 THEN RRX=0
1095 RRY=PAD(1,15)-128
1096 IF ABS(RRY)<25 THEN RRY=0
1097 CYW=CYW-RRX*0.0003
1098 CPT=CPT+RRY*0.0002
1099 IF CPT>1.5 THEN CPT=1.5
1100 IF CPT<-1.5 THEN CPT=-1.5
1101 LSX=PAD(1,14)-128
1102 IF ABS(LSX)<25 THEN LSX=0
1103 LSZ=PAD(1,13)-128
1104 IF ABS(LSZ)<25 THEN LSZ=0
1105 CX=CX-(LSX*MFZ)*0.008
1106 CZ=CZ+(LSX*MFX)*0.008
1107 FW=LSZ*0.008
1108 CX=CX+MFX*FW
1109 CZ=CZ+MFZ*FW
1110 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1111 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1112 IF PAD(1,3)>30 THEN CY=CY-0.5
1113 IF PAD(1,4)>30 THEN CY=CY+0.5
1114 CAMPOS 1,CX,CY,CZ
1115 CAMROT 1,CPT,CYW,0
1116 CLEAR
1117 IF SHUD=1 THEN
1118 LOCATE 0,0
1119 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1120 PRINT "FRAME ";QF1;"/18"
1121 END IF
1122 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1123 IF PAD(1,19)=0 THEN XVSEL=0
1124 IF PAD(1,19)>0 THEN XVSEL=1
1125 IF PAD(1,20)=1 THEN END
1126 FSYNC 1
1127 LOOP
1128 END