1000 ! === REVOLTOR.BAS — BPM model switcher ===
1001 INIT
1002 TEXTMODE 2
1003 CLEAR
1004 BGCOL 0,0,0
1005 MODLOAD "REVOLTOR/TORU_1KQ",1
1006 MODLOAD "REVOLTOR/SPHE_1QR",2
1007 MODSET 1,1,1
1008 MODOPT 1,1,1,0,1
1009 MODSET 2,2,1
1010 MODOPT 2,1,1,0,1
1011 MODDISP 1
1012 CAMPOS 1,0,0,-200
1013 CAMVEC 1,0,0,200
1014 LIGVEC 1,1,-2,1
1015 LIGCOL 1,200,200,220
1016 AMBCOL 50,50,60
1017 BT=INT(3600/120*2)
1018 TM=0
1019 CUR=1
1020 N=2
1021 RY=0
1022 FL=0
1023 TC=0
1024 TL=0
1025 TF=0
1026 T1=0
1027 T2=0
1028 T3=0
1029 T4=0
1030 XVP=0
1031 N1$="TORU_1KQ"
1032 N2$="SPHE_1QR"
1033 CZ=-200
1034 ZM=0
1035 SHOW=1
1036 SELVP=0
1037 DO
1038 IF PAD(1,20)>0 THEN END
1039 IF PAD(1,19)>0 AND SELVP=0 THEN SHOW=1-SHOW
1040 SELVP=PAD(1,19)
1041 IF PAD(1,12)>30 THEN ZM=ZM-3
1042 IF PAD(1,11)>30 THEN ZM=ZM+3
1043 IF ZM<-200 THEN ZM=-200
1044 IF ZM>100 THEN ZM=100
1045 CAMPOS 1,0,0,CZ+ZM
1046 TF=TF+1
1047 IF PAD(1,7)<30 THEN GOTO 1058
1048 IF XVP>0 THEN GOTO 1058
1049 TC=TC+1
1050 IF TC>4 THEN TC=1
1051 IF TC=1 THEN T1=TF
1052 IF TC=2 THEN T2=TF
1053 IF TC=3 THEN T3=TF
1054 IF TC=4 THEN T4=TF
1055 IF TC<>4 THEN GOTO 1058
1056 BT=INT((T4-T1)/3)*2
1057 TC=0
1058 ! tapskip
1059 XVP=PAD(1,7)
1060 RY=RY+2
1061 IF RY>360 THEN RY=RY-360
1062 MODROT CUR,0,RAD(RY),0
1063 TM=TM+1
1064 IF TM<>BT THEN GOTO 1071
1065 MODOFF CUR
1066 CUR=CUR+1
1067 IF CUR>N THEN CUR=1
1068 MODDISP CUR
1069 TM=0
1070 FL=3
1071 ! beatskip
1072 IF FL<=0 THEN GOTO 1076
1073 AMBCOL 255,255,255
1074 FL=FL-1
1075 GOTO 1078
1076 ! flashskip
1077 AMBCOL 50,50,60
1078 ! flashend
1079 IF SHOW=0 THEN GOTO 1086
1080 CLEAR
1081 IF CUR=1 THEN PRINT N1$
1082 IF CUR=2 THEN PRINT N2$
1083 PRINT "BPM: "; INT(3600*2/BT)
1084 PRINT "X TAP  SEL HUD  START EXIT"
1085 PRINT "L2/R2 ZOOM"
1086 ! hudskip
1087 FSYNC 1
1088 LOOP