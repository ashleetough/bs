1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="ANI7/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "ANI7/SCENE",1
1026 TEXLOAD "ANI7/MODEL"
1027 PALLOAD "ANI7/MODEL"
1028 ! --- object slots come from the config block above ---
1029 QT1=0
1030 QF1=1
1031 QD1=1
1032 ! --- set up all instances ---
1033 FOR I=1 TO NM
1034 MODSET I,MB(I),MO(I)
1035 MODDISP I
1036 MODPOS I,MX(I),MY(I),MZ(I)
1037 MODOPT I,MS(I),1,0,1
1038 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1039 NEXT I
1040 BGCOL 0,0,0
1041 AMBCOL 180,180,190
1042 LIGVEC 1,0.4,-1,0.3
1043 LIGCOL 1,255,255,220
1044 CX=0.0
1045 CY=0.0
1046 CZ=180
1047 CYW=3.1416
1048 CPT=0.0000
1049 SHUD=1
1050 XVSEL=0
1051 CLEAR
1052 DO
1053  QT1=QT1+1
1054  IF QT1>=8 THEN QF1=QF1+QD1
1055  IF QT1>=8 THEN QT1=0
1056  IF QF1>10 THEN QF1=1
1057  MODSET 1,1,QF1
1058 MFX=SIN(CYW)
1059 MFZ=COS(CYW)
1060 RRX=PAD(1,16)-128
1061 IF ABS(RRX)<25 THEN RRX=0
1062 RRY=PAD(1,15)-128
1063 IF ABS(RRY)<25 THEN RRY=0
1064 CYW=CYW-RRX*0.0003
1065 CPT=CPT+RRY*0.0002
1066 IF CPT>1.5 THEN CPT=1.5
1067 IF CPT<-1.5 THEN CPT=-1.5
1068 LSX=PAD(1,14)-128
1069 IF ABS(LSX)<25 THEN LSX=0
1070 LSZ=PAD(1,13)-128
1071 IF ABS(LSZ)<25 THEN LSZ=0
1072 CX=CX-(LSX*MFZ)*0.008
1073 CZ=CZ+(LSX*MFX)*0.008
1074 FW=LSZ*0.008
1075 CX=CX+MFX*FW
1076 CZ=CZ+MFZ*FW
1077 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1078 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1079 IF PAD(1,3)>30 THEN CY=CY-0.5
1080 IF PAD(1,4)>30 THEN CY=CY+0.5
1081 CAMPOS 1,CX,CY,CZ
1082 CAMROT 1,CPT,CYW,0
1083 CLEAR
1084 IF SHUD=1 THEN
1085 LOCATE 0,0
1086 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1087 PRINT "FRAME ";QF1;"/10"
1088 END IF
1089 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1090 IF PAD(1,19)=0 THEN XVSEL=0
1091 IF PAD(1,19)>0 THEN XVSEL=1
1092 IF PAD(1,20)=1 THEN END
1093 FSYNC 1
1094 LOOP
1095 END