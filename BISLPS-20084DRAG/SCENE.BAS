1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="DRAG/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "DRAG/SCENE",1
1026 TEXLOAD "DRAG/MODEL"
1027 PALLOAD "DRAG/MODEL"
1028 ! --- object slots come from the config block above ---
1029 ! --- set up all instances ---
1030 FOR I=1 TO NM
1031 MODSET I,MB(I),MO(I)
1032 MODDISP I
1033 MODPOS I,MX(I),MY(I),MZ(I)
1034 MODOPT I,MS(I),1,0,1
1035 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1036 NEXT I
1037 TILEPOS 1,0,0,640,224,0
1038 TILEDISP 1
1039 TILECOL 4,255,255,255,80
1040 TILEPOS 4,50,30,54,34,1
1041 TILEOFF 4
1042 TILECOL 5,255,255,255,80
1043 TILEPOS 5,120,15,124,19,1
1044 TILEOFF 5
1045 TILECOL 6,255,255,255,80
1046 TILEPOS 6,200,45,204,49,1
1047 TILEOFF 6
1048 TILECOL 7,255,255,255,80
1049 TILEPOS 7,310,20,314,24,1
1050 TILEOFF 7
1051 TILECOL 8,255,255,255,80
1052 TILEPOS 8,380,10,384,14,1
1053 TILEOFF 8
1054 TILECOL 9,255,255,255,80
1055 TILEPOS 9,450,35,454,39,1
1056 TILEOFF 9
1057 TILECOL 10,255,255,255,80
1058 TILEPOS 10,520,18,524,22,1
1059 TILEOFF 10
1060 TILECOL 11,255,255,255,80
1061 TILEPOS 11,580,40,584,44,1
1062 TILEOFF 11
1063 TILECOL 12,255,255,255,80
1064 TILEPOS 12,90,55,94,59,1
1065 TILEOFF 12
1066 TILECOL 13,255,255,255,80
1067 TILEPOS 13,260,8,264,12,1
1068 TILEOFF 13
1069 CX=0.0
1070 CY=0.0
1071 CZ=180
1072 CYW=3.1416
1073 CPT=0.0000
1074 SHUD=1
1075 XVSEL=0
1076 CLEAR
1077 DO
1078 MFX=SIN(CYW)
1079 MFZ=COS(CYW)
1080 RRX=PAD(1,16)-128
1081 IF ABS(RRX)<25 THEN RRX=0
1082 RRY=PAD(1,15)-128
1083 IF ABS(RRY)<25 THEN RRY=0
1084 CYW=CYW-RRX*0.0003
1085 CPT=CPT+RRY*0.0002
1086 IF CPT>1.5 THEN CPT=1.5
1087 IF CPT<-1.5 THEN CPT=-1.5
1088 LSX=PAD(1,14)-128
1089 IF ABS(LSX)<25 THEN LSX=0
1090 LSZ=PAD(1,13)-128
1091 IF ABS(LSZ)<25 THEN LSZ=0
1092 CX=CX-(LSX*MFZ)*0.008
1093 CZ=CZ+(LSX*MFX)*0.008
1094 FW=LSZ*0.008
1095 CX=CX+MFX*FW
1096 CZ=CZ+MFZ*FW
1097 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1098 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1099 IF PAD(1,3)>30 THEN CY=CY-0.5
1100 IF PAD(1,4)>30 THEN CY=CY+0.5
1101 CAMPOS 1,CX,CY,CZ
1102 CAMROT 1,CPT,CYW,0
1103 CLEAR
1104 IF SHUD=1 THEN
1105 LOCATE 0,0
1106 PRINT "X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1107 END IF
1108 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1109 IF PAD(1,19)=0 THEN XVSEL=0
1110 IF PAD(1,19)>0 THEN XVSEL=1
1111 IF PAD(1,20)=1 THEN END
1112 FSYNC 1
1113 LOOP
1114 END