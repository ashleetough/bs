1000 ! === MACE MODEL VIEWER v7 ===
1010 ! Tri=FX  SQ=spin  Ci=cam  X=tap BPM  R3=light  L-stk=light dir
1020 ! L1/R1=zoom  up/dn=speed  SELECT=HUD  START=exit
1030 !
1040 INIT
1050 TEXTMODE 2
1060 CLEAR
1070 LOCATE 0,0
1080 PRINT "Now Loading..."
1090 MODLOAD "MACE/MACE",1
1100 MODSET 1,1,1
1110 MODDISP 1
1120 MODPOS 1,0,0,0
1130 MODOPT 1,1,1,0,1
1140 LIGVEC 1,1,-2,1
1150 LIGCOL 1,220,220,220
1160 NLR=220
1170 NLG=220
1180 NLB=220
1190 AMBCOL 60,60,60
1200 CAMPOS 1,0,0,-60
1210 CAMVEC 1,0,0,1
1220 BGCOL 0,0,0
1230 FOR TN=1 TO 6
1240  TILECOL TN,255,255,255,0
1250  TILEPOS TN,0,0,1,1,16777000
1260 NEXT TN
1270 P=OBJPOLY(1,1)
1280 PRINT "Polygons: ";P
1290 RX=0
1300 RY=0
1310 SC=1
1320 AUTOSP=1
1330 SQVP=0
1340 SHOW=1
1350 SELVP=0
1360 STRB=0
1370 TRVP=0
1380 BEAT=0
1390 HIT=99
1400 GI=0
1410 TAPF=0
1420 TAPV=0
1430 TAPL=0
1440 TAPC=0
1440 UPVP=0
1450 DNVP=0
1460 XVVP=0
1470 CIVP=0
1480 R3VP=0
1480 CAMFR=0
1490 SI=9
1500 DIM ST(0 TO 12)
1501 ST(0)=-12
1502 ST(1)=-6
1503 ST(2)=-3
1504 ST(3)=-1.5
1505 ST(4)=-0.75
1506 ST(5)=-0.375
1507 ST(6)=0
1508 ST(7)=0.375
1509 ST(8)=0.75
1510 ST(9)=1.5
1511 ST(10)=3
1512 ST(11)=6
1513 ST(12)=12
1516 SPD=ST(SI)
1520 BPM=120
1560 FOR WT=1 TO 120
1570  FSYNC 1
1580 NEXT WT
1590 CLEAR
1600 DO
1610  IF AUTOSP=0 THEN
1620   RY=RY+(PAD(1,1)-PAD(1,2))/3
1630   RX=RX+(PAD(1,3)-PAD(1,4))/3
1640  ELSE
1650   RY=RY+(PAD(1,1)-PAD(1,2))/3
1660   IF PAD(1,3)>200 AND UPVP=0 THEN
1670    SI=SI+1
1680    IF SI>12 THEN SI=12
1690    SPD=ST(SI)
1700   END IF
1710   IF PAD(1,3)>200 THEN UPVP=1 ELSE UPVP=0
1720   IF PAD(1,4)>200 AND DNVP=0 THEN
1730    SI=SI-1
1740    IF SI<0 THEN SI=0
1750    SPD=ST(SI)
1760   END IF
1770   IF PAD(1,4)>200 THEN DNVP=1 ELSE DNVP=0
1780  END IF
1790  IF RX>85 THEN RX=85
1800  IF RX<-85 THEN RX=-85
1810  IF RY>=360 THEN RY=RY-360
1820  IF RY<0 THEN RY=RY+360
1830  IF AUTOSP=1 THEN RY=RY+SPD
1840  SC=SC+(PAD(1,10)-PAD(1,9))/2000
1850  IF SC<0.05 THEN SC=0.05
1860  IF SC>20 THEN SC=20
1870  MODOPT 1,SC,1,0,1
1871  
1880  LX=(PAD(1,14)-127)/127
1890  LY=(PAD(1,13)-127)/127
1900  IF ABS(LX)>0.1 OR ABS(LY)>0.1 THEN
1910   LIGVEC 1,LX,-LY,1
1920  END IF
1930  IF PAD(1,8)>200 AND SQVP=0 THEN AUTOSP=1-AUTOSP
1940  IF PAD(1,8)>200 THEN SQVP=1 ELSE SQVP=0
1950  IF PAD(1,5)>0 AND TRVP=0 THEN
1960   STRB=1-STRB
1970   IF STRB=0 THEN
1980    LIGCOL 1,NLR,NLG,NLB
1990    BGCOL 0,0,0
2000    BEAT=0
2010    HIT=99
2020    GI=0
2030    FOR TN=1 TO 6
2040     TILEOFF TN
2050    NEXT TN
2060   END IF
2070  END IF
2080  TRVP=PAD(1,5)
2090  IF PAD(1,6)>0 AND CIVP=0 THEN
2100   CAMFR=1-CAMFR
2110   IF CAMFR=0 THEN CAMPOS 1,0,0,-60
2120   IF CAMFR=1 THEN CAMPOS 1,0,0,-200
2130  END IF
2140  CIVP=PAD(1,6)
2150  IF PAD(1,18)=1 AND R3VP=0 THEN
2160   NLR=INT(RND*200)+55
2170   NLG=INT(RND*200)+55
2180   NLB=INT(RND*200)+55
2190   IF STRB=0 THEN LIGCOL 1,NLR,NLG,NLB
2200  END IF
2210  R3VP=PAD(1,18)
2220  IF PAD(1,7)>30 AND XVVP=0 THEN
2230   IF TAPL>0 AND TAPF-TAPL<540 THEN
2240    TAPV=TAPV+(TAPF-TAPL)
2250    TAPC=TAPC+1
2260    IF TAPC>=4 THEN
2270     BPM=INT(3600/(TAPV/TAPC)+0.5)
2280     IF BPM<40 THEN BPM=40
2290     IF BPM>300 THEN BPM=300
2300     TAPV=0
2310     TAPC=0
2320     BEAT=0
2330    END IF
2340   ELSE
2350    TAPV=0
2360    TAPC=0
2370   END IF
2380   TAPL=TAPF
2390  END IF
2400  IF PAD(1,7)>30 THEN XVVP=1 ELSE XVVP=0
2410  TAPF=TAPF+1
2570  IF STRB=1 THEN
2580   FPB=INT(3600/BPM)
2590   BEAT=BEAT+1
2600   IF BEAT>=FPB THEN
2610    BEAT=0
2620    HIT=0
2630   END IF
2640   IF HIT=0 THEN
2650    LIGCOL 1,255,255,255
2660    BGCOL 20,0,20
2670    GI=2
2680   ELSEIF HIT=6 THEN
2690    LIGCOL 1,15,15,15
2700    BGCOL 0,0,0
2710    GI=1
2720   ELSEIF HIT=9 THEN
2730    LIGCOL 1,180,80,255
2740    BGCOL 10,0,15
2750    GI=2
2760   ELSEIF HIT=15 THEN
2770    LIGCOL 1,15,15,15
2780    BGCOL 0,0,0
2790    GI=1
2800   ELSEIF HIT=18 THEN
2810    LIGCOL 1,NLR,NLG,NLB
2820    BGCOL 0,0,0
2830    GI=0
2840   END IF
2850   IF HIT<99 THEN HIT=HIT+1
2860   FOR TN=1 TO 6
2870    IF GI=0 THEN
2880     IF RND<0.05 THEN
2890      TILECOL TN,INT(RND*80),INT(RND*80),INT(RND*80),INT(RND*15)
2900      TILEPOS TN,INT(RND*600),INT(RND*200),INT(RND*640),INT(RND*224),16777000
2910      TILEDISP TN
2920     ELSE
2930      TILEOFF TN
2940     END IF
2950    ELSEIF GI=1 THEN
2960     TX1=INT(RND*580)
2970     TY1=INT(RND*180)
2980     TX2=TX1+INT(RND*60)+10
2990     TY2=TY1+INT(RND*40)+8
3000     TILECOL TN,INT(RND*200),INT(RND*100),INT(RND*255),INT(RND*60)+20
3010     TILEPOS TN,TX1,TY1,TX2,TY2,16777000
3020     TILEDISP TN
3030    ELSE
3040     TX1=INT(RND*400)
3050     TY1=INT(RND*140)
3060     TX2=TX1+INT(RND*240)+40
3070     TY2=TY1+INT(RND*84)+20
3080     TR=INT(RND*2)*255
3090     TG=INT(RND*2)*200
3100     TB=INT(RND*2)*255
3110     TILECOL TN,TR,TG,TB,INT(RND*80)+48
3120     TILEPOS TN,TX1,TY1,TX2,TY2,16777000
3130     TILEDISP TN
3140    END IF
3150   NEXT TN
3160  END IF
3170  MODROT 1,RAD(RX),RAD(RY),0
3180  CLEAR
3190  IF SHOW=1 THEN
3200   LOCATE 0,0
3210   PRINT "MACE  POLY:";P
3220   IF AUTOSP=1 THEN
3230    PRINT "SPIN:";SPD;"  up/dn=step"
3240   ELSE
3250    PRINT "MANUAL  X:";INT(RX);"  Y:";INT(RY)
3260   END IF
3270   PRINT "SC:";INT(SC*100)/100;"  CAM:";CAMFR
3280   IF STRB=1 THEN PRINT "BPM:";BPM;"  X=tap(";TAPC;"/4)"
3290   PRINT "SELECT=HIDE  START=EXIT"
3300  END IF
3310  IF PAD(1,19)=1 AND SELVP=0 THEN SHOW=1-SHOW
3320  SELVP=PAD(1,19)
3330  IF PAD(1,20)>0 THEN END
3340  FSYNC 1
3350 LOOP
3360 END
