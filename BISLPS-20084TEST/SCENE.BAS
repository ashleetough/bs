1000 INIT
1001 TEXTMODE 1
1002 CLEAR
1003 DIM NM$(0 TO 49)
1004 DIM MB(0 TO 49)
1005 DIM MO(0 TO 49)
1006 DIM MX(0 TO 49)
1007 DIM MY(0 TO 49)
1008 DIM MZ(0 TO 49)
1009 DIM MS(0 TO 49)
1010 DIM MRX(0 TO 49)
1011 DIM MRY(0 TO 49)
1012 ! --- SCENE CONFIG ---
1013 NM=1
1014 NM$(1)="TEST/SCENE"
1015 MB(1)=1
1016 MO(1)=1
1017 MX(1)=0
1018 MY(1)=0
1019 MZ(1)=0
1020 MS(1)=1.000
1021 MRX(1)=0
1022 MRY(1)=0
1023 ! --- END CONFIG ---
1024 ! --- load unique buffers ---
1025 MODLOAD "TEST/SCENE",1
1026 ! --- object slots come from the config block above ---
1027 ! --- set up all instances ---
1028 FOR I=1 TO NM
1029 MODSET I,MB(I),MO(I)
1030 MODDISP I
1031 MODPOS I,MX(I),MY(I),MZ(I)
1032 MODOPT I,MS(I),1,0,1
1033 MODROT I,RAD(MRX(I)),RAD(MRY(I)),0
1034 NEXT I
1035 BGCOL 0,0,0
1036 AMBCOL 180,180,190
1037 LIGVEC 1,1,-2,1
1038 LIGCOL 1,255,255,220
1039 CX=0.0
1040 CY=0.0
1041 CZ=180
1042 CYW=3.1416
1043 CPT=0.0000
1044 SHUD=1
1045 XVSEL=0
1046 CLEAR
1047 DO
1048 MFX=SIN(CYW)
1049 MFZ=COS(CYW)
1050 RRX=PAD(1,16)-128
1051 IF ABS(RRX)<25 THEN RRX=0
1052 RRY=PAD(1,15)-128
1053 IF ABS(RRY)<25 THEN RRY=0
1054 CYW=CYW-RRX*0.0003
1055 CPT=CPT+RRY*0.0002
1056 IF CPT>1.5 THEN CPT=1.5
1057 IF CPT<-1.5 THEN CPT=-1.5
1058 LSX=PAD(1,14)-128
1059 IF ABS(LSX)<25 THEN LSX=0
1060 LSZ=PAD(1,13)-128
1061 IF ABS(LSZ)<25 THEN LSZ=0
1062 CX=CX-(LSX*MFZ)*0.008
1063 CZ=CZ+(LSX*MFX)*0.008
1064 FW=LSZ*0.008
1065 CX=CX+MFX*FW
1066 CZ=CZ+MFZ*FW
1067 IF PAD(1,2)>30 THEN CYW=CYW-0.03
1068 IF PAD(1,1)>30 THEN CYW=CYW+0.03
1069 IF PAD(1,3)>30 THEN CY=CY-0.5
1070 IF PAD(1,4)>30 THEN CY=CY+0.5
1071 CAMPOS 1,CX,CY,CZ
1072 CAMROT 1,CPT,CYW,0
1073 CLEAR
1074 IF SHUD=1 THEN
1075 LOCATE 0,0
1076 PRINT "CAM X:";INT(CX);" Y:";INT(CY);" Z:";INT(CZ)
1077 END IF
1078 IF PAD(1,19)>0 AND XVSEL=0 THEN SHUD=1-SHUD
1079 IF PAD(1,19)=0 THEN XVSEL=0
1080 IF PAD(1,19)>0 THEN XVSEL=1
1081 IF PAD(1,20)=1 THEN END
1082 FSYNC 1
1083 LOOP
1084 END