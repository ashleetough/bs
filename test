12. SPECIFIC VIEWPORT SELECTION IMPLEMENTATION
==================================================

A safe first version:

    if (hits.length) {
        const hid = hits[0].object.userData.gid;

        if (e.ctrlKey || e.metaKey) {
            setSelIds(prev => {
                const next = new Set(prev);

                if (next.has(hid)) {
                    next.delete(hid);

                    if (selRef.current === hid) {
                        const replacement = next.values().next().value ?? null;
                        selRef.current = replacement;
                        setSelId(replacement);
                    }
                } else {
                    next.add(hid);
                    selRef.current = hid;
                    setSelId(hid);
                }

                return next;
            });
        } else {
